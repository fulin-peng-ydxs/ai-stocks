{
  "suites": {
    "secrets": {
      "kind": "secrets",
      "common": true,
      "description": "受控源码及本次提交范围的密钥扫描；精确固定材料例外到期阻断"
    },
    "quality": {
      "kind": "quality",
      "common": true,
      "description": "后端 Ruff 默认规则与全部 GitHub workflow 语法检查"
    },
    "frontend": {
      "kind": "frontend",
      "common": true,
      "description": "前端设计静态、全量离线 Vitest、类型及生产构建；拒绝不完整执行"
    },
    "backend": {
      "kind": "backend",
      "common": true,
      "description": "隔离三库中的后端业务、权限及任务回归；新增测试默认加入"
    },
    "database": {
      "kind": "database",
      "common": true,
      "description": "现有数据库新装、旧库升级、结构及初始化数据契约"
    },
    "dependency-audit": {
      "kind": "audit",
      "common": true,
      "when": "dependencies",
      "description": "Python CI 锁与 npm 锁的全部依赖漏洞审计；每日及手动可独立调用"
    },
    "backend-scale": {
      "kind": "backend",
      "common": false,
      "description": "显式规模参数下的分时、估值与质量修复规模回归",
