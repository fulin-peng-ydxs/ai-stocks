# 本机后端启动环境变量示例。
# 使用方式：复制为 .env.local 后填写真实值；.env.local 已被 Git 忽略。
# 完整变量表和加载生效逻辑见 agent-works/architecture/environment-configuration.md。

# 必填：JWT 签名密钥。建议使用至少 32 字节随机串。
# 生成示例：openssl rand -hex 32
# AI_STOCKS_JWT_SECRET=

# 可选：首次部署 seed admin 密码。admin 是默认租户 default 下的平台系统管理员，
# 用于初始化、系统级运维和最高权限验收，不作为普通权限边界测试账号。
# 不填时后端会随机生成并写一次启动日志告警。
# 本地开发约定账号：admin / Admin@12345；生产或共享环境必须改成强密码。
# AI_STOCKS_ADMIN_PASSWORD=Admin@12345

# 可选：本地 RBAC 调试用户统一密码。执行 `python -m backend.cli dev-users`
# 创建 debug_* 测试账号时读取；不设置则本地开发默认回落 Test@12345。
# 这些账号仅用于本地/测试库的页面和接口权限验收，详见 agent-works/multi-tenant-rbac/test-users.md。
# AI_STOCKS_TEST_USER_PASSWORD=Test@12345

# 可选：公网/密码认证 PG 或 Redis 时再配置；本机 trust/无密码可不填。
# AI_STOCKS_PG_PASSWORD=
# AI_STOCKS_PG_DSN=
# AI_STOCKS_REDIS_PASSWORD=
# AI_STOCKS_REDIS_URL=

# 高级可选：非日常开发一般不需要。
# AI_STOCKS_CONFIG=config/settings.yaml
# AI_STOCKS_ENV=dev
# AI_STOCKS_FILE_LOG=0
