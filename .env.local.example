# 本机后端启动环境变量示例。
# 使用方式：复制为 .env.local 后填写真实值；.env.local 已被 Git 忽略。
# 完整变量表和加载生效逻辑见 agent-works/architecture/environment-configuration.md。

# 必填：JWT 签名密钥。建议使用至少 32 字节随机串。
# 生成示例：openssl rand -hex 32
# AI_STOCKS_JWT_SECRET=

# 页面保存 Cookie 等敏感配置时必填：Fernet 主密钥，与 JWT 密钥分离。
# 生成示例：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 生产可改用 AI_STOCKS_CONFIG_ENCRYPTION_KEY_FILE 指向仅后端进程可读的 0600 密钥文件。
# AI_STOCKS_CONFIG_ENCRYPTION_KEY=
# AI_STOCKS_CONFIG_ENCRYPTION_KEY_FILE=

# 可选：首次部署 seed admin 密码。admin 是默认租户 default 下的平台系统管理员，
# 用于初始化、系统级运维和最高权限验收，不作为普通权限边界测试账号。
# 不填时后端会随机生成并写一次启动日志告警。
# 本地开发约定账号：admin / Admin@12345；生产或共享环境必须改成强密码。
# AI_STOCKS_ADMIN_PASSWORD=Admin@12345

# 可选：本地 RBAC 调试用户统一密码。执行 `./start.sh dev-users`
# 创建 debug_* 测试账号和 `npm run test:e2e` 登录时读取；支持
# `KEY=value` 或 `export KEY=value`，不设置则本地开发默认回落 Test@12345。
# 这些账号仅用于本地/测试库的页面和接口权限验收，详见 agent-works/multi-tenant-rbac/test-users.md。
# AI_STOCKS_TEST_USER_PASSWORD=Test@12345

# 可选：公网/密码认证 PG 或 Redis 时再配置；本机 trust/无密码可不填。
# AI_STOCKS_PG_PASSWORD=
# AI_STOCKS_PG_DSN=
# AI_STOCKS_REDIS_PASSWORD=
# AI_STOCKS_REDIS_URL=

# 可选：真实发送注册邮箱验证码时配置（settings.yaml 的 mail 段仅为安全基线：默认关闭、账号留空）。
# 真实发信开关与账号走以下环境变量覆盖，个人/部署账号不入仓库；host/port/use_ssl 在 settings.yaml 配。
# Gmail 等用「应用专用密码」：先开两步验证，再到 https://myaccount.google.com/apppasswords 生成。
# AI_STOCKS_SMTP_ENABLED=1
# AI_STOCKS_SMTP_USERNAME=you@gmail.com
# AI_STOCKS_SMTP_SENDER="复盘啦 <you@gmail.com>"
# AI_STOCKS_SMTP_PASSWORD=

# 可选：同花顺板块登录态 Cookie（解除翻页登录墙取全深页板块/成分，概念 375→390）。
# 浏览器登录同花顺后复制完整 Cookie 头；也可用 AI_STOCKS_THS_COOKIE_FILE 指向存有 Cookie 的文件。
# 优先级高于数据治理「同花顺板块·登录 Cookie」页面配置；不配置也能采集，只是被登录墙截断。
# AI_STOCKS_THS_COOKIE=
# AI_STOCKS_THS_COOKIE_FILE=

# 本地调试数据写入必须明确标记环境；空值、未知值、prod/production 均 fail-closed。
# 生产和共享公网环境禁止设为 dev/test/local。
# AI_STOCKS_CONFIG=config/settings.yaml
# AI_STOCKS_ENV=dev

# 仅运行会创建并物理销毁临时用户的 Playwright 用例时短暂设为 1，并让后端和
# `npm run test:e2e` 同时继承；日常开发保持未设置。
# AI_STOCKS_E2E_WRITE=1

# 高级可选：非日常开发一般不需要。
# AI_STOCKS_FILE_LOG=0
