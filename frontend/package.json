{
  "name": "ai-stocks-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:design && vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:design": "node scripts/check-design-test-env.mjs && npm test && npm run build && ../scripts/run-design-e2e.sh",
    "test:e2e": "../scripts/run-playwright.sh",
    "test:e2e:sectors": "../scripts/run-sector-e2e.sh",
    "test:e2e:stock-board-correlation": "../scripts/run-stock-board-correlation-e2e.sh",
    "test:e2e:trade-discipline": "../scripts/run-trade-discipline-e2e.sh",
    "test:e2e:ui": "../scripts/run-playwright.sh --ui",
    "test:e2e:install": "playwright install chromium",
    "scaffold-page": "node scripts/scaffold-page.mjs",
    "postinstall": "node scripts/verify-dependency-patches.mjs && patch-package --error-on-fail",
    "check:table-headers": "node scripts/check-table-headers.mjs",
    "check:typography": "node scripts/check-typography.mjs",
    "check:close-controls": "node scripts/check-close-controls.mjs",
    "check:tooltips": "node scripts/check-tooltip-contract.mjs",
    "check:scrollbars": "node scripts/check-scrollbars.mjs",
    "check:borders": "node scripts/check-borders.mjs",
    "check:control-rows": "node scripts/check-control-rows.mjs",
    "check:numbers": "node scripts/check-numbers.mjs",
    "check:design": "node scripts/check-design.mjs",
    "check:contracts": "node scripts/check-design-contracts.mjs",
    "docs:responsive": "node scripts/check-responsive-inventory.mjs --write",
    "check:responsive": "node scripts/check-responsive-inventory.mjs",
    "check:contracts:docs": "node scripts/check-design-contracts.mjs --docs",
    "test:contracts": "vitest run src/layout/__tests__",
    "check": "npm run check:design && npm run test:contracts && vue-tsc -b",
    "pretest": "npm run check:design"
  },
  "dependencies": {
    "@popperjs/core": "npm:@sxzz/popperjs-es@2.11.8",
    "axios": "^1.7.2",
    "echarts": "5.6.0",
    "element-plus": "2.14.1",
    "patch-package": "8.0.1",
    "pinia": "^2.1.7",
    "vue": "^3.4.0",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^20.12.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^24.1.3",
    "postcss": "8.5.15",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^1.6.0",
    "vue-tsc": "^2.0.0"
  }
}
