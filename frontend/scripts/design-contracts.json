  "styleRoles": [
    {
      "className": "app-interaction-list-item--outlined",
      "properties": [
        "background",
        "background-color",
        "border",
        "border-color",
        "border-top",
        "border-right",
        "border-bottom",
        "border-left",
        "box-shadow",
        "color",
        "--app-interaction-selected-background",
        "--app-interaction-selected-marker",
        "--el-color-primary"
      ],
      "descendants": true
    },
    {
      "className": "app-interaction-link--primary",
      "properties": [
        "color",
        "--app-interaction-selected-background",
        "--app-interaction-selected-marker",
        "--el-color-primary"
      ],
      "descendants": true
    },
    {
      "className": "app-table-field-link",
      "properties": [
        "font",
        "font-family",
        "font-size",
        "font-weight",
        "line-height",
        "--app-interaction-selected-background",
        "--app-interaction-selected-marker",
        "--el-color-primary"
      ],
      "descendants": true
    }
  ],
  "listStates": [
    {
      "name": "基础列表选中",
      "selector": ".app-interaction-list-item:is(.active, .on, [aria-pressed='true'])",
      "declarations": {
        "background": "var(--app-interaction-selected-background)"
      },
      "forbidden": [
        "box-shadow",
        "border-left"
      ]
    },
    {
      "name": "描边列表普通",
      "selector": ".app-interaction-list-item.app-interaction-list-item--outlined",
      "declarations": {
        "border": "1px solid var(--el-border-color-light)"
      }
    },
    {
      "name": "描边列表选中",
      "selector": ".app-interaction-list-item--outlined:is(.active, .on, [aria-pressed='true'])",
      "declarations": {
        "border-color": "var(--el-color-primary)",
        "box-shadow": "var(--app-interaction-selected-marker)"
      }
    },
    {
      "name": "列表按下",
      "selector": ".app-interaction-list-item:not(:disabled, [aria-disabled='true'], [aria-busy='true']):active",
      "declarations": {
        "border-color": "var(--el-color-primary)"
      },
      "forbidden": [
        "background",
        "background-color"
      ]
    },
    {
      "name": "基础列表悬停",
      "selector": ".app-interaction-list-item:not(.active, .on, [aria-pressed='true'], :disabled, [aria-disabled='true'], [aria-busy='true']):hover",
      "declarations": {
        "background": "var(--chrome-bg-soft-hover)"
      },
      "media": "(hover: hover) and (pointer: fine)"
    },
    {
      "name": "描边列表悬停",
      "selector": ".app-interaction-list-item--outlined:not(.active, .on, [aria-pressed='true'], :disabled, [aria-disabled='true'], [aria-busy='true']):hover",
      "declarations": {
        "border-color": "var(--chrome-border-strong)"
      },
      "media": "(hover: hover) and (pointer: fine)"
    }
  ],
